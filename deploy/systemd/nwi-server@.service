[Unit]
Description=Day of Infamy or Insurgency server (%i)
# The layers of nwi-update.service, which mustn't change while they're mounted
After=network-online.target nwi-update.service
Wants=network-online.target nwi-update.service
# Stopped and restarted with the servers' target, see nwi-restart.service
PartOf=nwi-servers.target
# srcds_watchdog.py's restarts of a server that stopped answering: at most 6 an hour
StartLimitIntervalSec=1h
StartLimitBurst=6

[Service]
# srcds_watchdog.py runs the server: ready once it first answers A2S queries, restarted by the watchdog
# once it doesn't answer for WatchdogSec. Its SIGABRT goes to the server, which dumps its core then.
Type=notify
WatchdogSec=90
# The time the hung server has to dump its core after the watchdog's SIGABRT, before it's killed. A
# stopped process (SIGSTOP) only dies then, as it doesn't receive the SIGABRT.
TimeoutAbortSec=30
# A user of its own, for each server: a server can't change another's files or the layers they share.
# Named by the instance: systemd would name it after the template, one user for all servers.
DynamicUser=yes
User=nwi-server-%i
# Its settings, without secrets, which are credentials
EnvironmentFile=/etc/nwi-server/%i.env
# What it keeps, e.g. its logs (nwi-server mount)
StateDirectory=nwi-server/servers/%i
# Its secrets, from the credential store (systemd-creds, /etc/credstore.encrypted): the server's own,
# nwi-server@<server>.<name>, before those of all servers, nwi-server.<name>, as server.<name>
# (tools/prepare_server.sh)
ImportCredential=nwi-server@%i.*:server.
ImportCredential=nwi-server.*:server.
# The server's layers, which the first ExecStartPre= mounts there, not a RuntimeDirectory=: systemd
# would remove it with the server's files when the server stops, before the layers are unmounted.
# prepare_server.sh writes its RCON password to /run/nwi-server/rcon. Both may be missing ("-") for the
# first ExecStartPre=, which makes them: systemd sets up the unit's namespace for it too.
ReadWritePaths=-/run/nwi-server/%i -/run/nwi-server/rcon
WorkingDirectory=-/run/nwi-server/%i
Environment=LD_LIBRARY_PATH=/run/nwi-server/%i:/run/nwi-server/%i/bin
# The layers, mounted anew at every start, mapped to the server's user: as root ("+"), in the system's
# mount namespace (nsenter), where the updater's state is, which a unit of a dynamic user doesn't see,
# and whose mounts the server sees. Unmounted when it stops, also when mounting failed.
ExecStartPre=+/usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/nwi-server mount %i %n
ExecStopPost=+/usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/nwi-server unmount %i
# Configured as root ("!"), as the layers of the packages belong to root
ExecStartPre=!/usr/lib/nwi-server-kit/prepare_server.sh /run/nwi-server/%i %i
# The command line of the server's server.toml and environment file, run by srcds_watchdog.py
ExecStart=/usr/lib/nwi-server-kit/start_server.sh /run/nwi-server/%i
KillSignal=SIGINT
# The stop signal to srcds_watchdog.py only, which passes it on to the server
KillMode=mixed
# The server ends on it, which srcds_watchdog.py reports as 128 + SIGINT: a stop, not a failure
SuccessExitStatus=130
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
Restart=always
RestartSec=10
TimeoutStartSec=infinity

[Install]
WantedBy=nwi-servers.target
