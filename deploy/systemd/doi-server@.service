[Unit]
Description=Day of Infamy server (%i)
After=network-online.target doi-update.service doi-mount@%i.service
Wants=network-online.target doi-update.service
# The server's layers (doi-mount@.service, after doi-update.service): the server only runs with them, and
# stops when they're unmounted
BindsTo=doi-mount@%i.service
# Stopped and restarted with the servers' target, see doi-restart.service
PartOf=doi-servers.target
# srcds_watchdog.py's restarts of a server that stopped answering: at most 6 an hour
StartLimitIntervalSec=1h
StartLimitBurst=6

[Service]
# srcds_watchdog.py runs the server: ready once it first answers A2S queries, restarted by the watchdog
# once it doesn't answer for WatchdogSec. Its SIGABRT goes to the server, which dumps its core then.
Type=notify
WatchdogSec=90
# The time the hung server has to dump its core after the watchdog's SIGABRT, before it's killed. A
# stopped process (SIGSTOP) only dies then, as it doesn't receive the SIGABRT.
TimeoutAbortSec=30
User=doi
EnvironmentFile=/etc/doi-server/%i.env
StateDirectory=doi-server
StateDirectoryMode=0750
# The server's layers, which doi-mount@.service mounts there, not a RuntimeDirectory=: systemd would
# remove it with the server's files when the server stops, before the layers are unmounted
ReadWritePaths=/run/doi-server/%i
WorkingDirectory=/run/doi-server/%i
Environment=LD_LIBRARY_PATH=/run/doi-server/%i:/run/doi-server/%i/bin
# Configured as root ("!"), as the layers of the packages belong to root
ExecStartPre=!%S/doi-server/doi-config/tools/prepare_server.sh /run/doi-server/%i %i
# The patcher of the server library (tools/doi_patch.c), which doi-update.service builds; the launcher
# preloads it into srcds only and fails without it, as the loader would only warn
Environment=DOI_PATCH=%S/doi-server/doi_patch.so
# The command line of the server's server.toml and environment file, run by srcds_watchdog.py
ExecStart=%S/doi-server/doi-config/tools/start_server.sh /run/doi-server/%i
KillSignal=SIGINT
# The stop signal to srcds_watchdog.py only, which passes it on to the server
KillMode=mixed
# The server ends on it, which srcds_watchdog.py reports as 128 + SIGINT: a stop, not a failure
SuccessExitStatus=130
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
Restart=always
RestartSec=10
TimeoutStartSec=infinity

[Install]
WantedBy=doi-servers.target
