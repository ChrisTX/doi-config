[Unit]
Description=Update and restart the Day of Infamy or Insurgency servers

[Service]
Type=oneshot
# The update while the servers run, which adds versions of the layers but changes none they use, so
# that they're only down for the restart, which gives them the newest versions
ExecStart=/usr/bin/systemctl restart nwi-update.service
ExecStart=/usr/bin/systemctl restart nwi-servers.target
