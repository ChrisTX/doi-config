[Unit]
Description=Update the games of the Day of Infamy or Insurgency servers and their configs
After=network-online.target
Wants=network-online.target
# The servers are the overlays of the game install, which mustn't change while they run: they start
# after it, and nwi-restart.service stops them before running it again
Before=nwi-servers.target

[Service]
Type=oneshot
# Active once done, so a server that starts or restarts on its own doesn't run it again
RemainAfterExit=yes
# A user of its own, which the servers can't write as. The layers are its state, which it shares
# with nwi-stage.service and nwi-update-check.service; the servers mount them mapped to their users
# (tools/mount_server.sh).
DynamicUser=yes
StateDirectory=nwi-server/layers
# DepotDownloader keeps its settings in the home folder
Environment=HOME=%S/nwi-server/layers
# Puts an update that nwi-stage.service staged in place, or updates in place, e.g. at boot
ExecStart=/usr/lib/nwi-server-kit/update_layers.sh %S/nwi-server/layers
TimeoutStartSec=infinity
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
