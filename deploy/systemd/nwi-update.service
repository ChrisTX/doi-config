[Unit]
Description=Update the games of the Day of Infamy or Insurgency servers and their configs
After=network-online.target
Wants=network-online.target
# The servers mount its layers' newest versions: at boot, they start after it. It adds versions while
# they run, which they get when they start again (nwi-restart.service).
Before=nwi-servers.target

[Service]
Type=oneshot
# Active once done, so a server that starts or restarts on its own doesn't run it again
RemainAfterExit=yes
# A user of its own, which the servers can't write as. The layers are its state, which it shares
# with nwi-update-check.service; the servers mount them mapped to their users (nwi-server mount).
DynamicUser=yes
StateDirectory=nwi-server/layers
# DepotDownloader keeps its settings in the home folder
Environment=HOME=%S/nwi-server/layers
ExecStart=/usr/bin/nwi-server update %S/nwi-server/layers
TimeoutStartSec=infinity
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
