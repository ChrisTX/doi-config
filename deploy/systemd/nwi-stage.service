[Unit]
Description=Stage an update of the games of the Day of Infamy or Insurgency servers and their configs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nwi-server
StateDirectory=nwi-server
StateDirectoryMode=0750
# SteamCMD keeps its files in the home folder
Environment=HOME=%S/nwi-server
# The update goes into a reflinked copy of the layers while the servers run on them, which
# nwi-update.service puts in place once nwi-restart.service has stopped them
ExecStart=/usr/lib/nwi-server-kit/update_layers.sh --stage %S/nwi-server
TimeoutStartSec=infinity
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
