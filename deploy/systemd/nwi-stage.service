[Unit]
Description=Stage an update of the games of the Day of Infamy or Insurgency servers and their configs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A user of its own, which the servers can't write as. The layers are its state, which it shares
# with nwi-stage.service and nwi-update-check.service; the servers mount them mapped to their users
# (tools/mount_server.sh).
DynamicUser=yes
StateDirectory=nwi-server/layers
# DepotDownloader keeps its settings in the home folder
Environment=HOME=%S/nwi-server/layers
# The update goes into a reflinked copy of the layers while the servers run on them, which
# nwi-update.service puts in place once nwi-restart.service has stopped them
ExecStart=/usr/lib/nwi-server-kit/update_layers.sh --stage %S/nwi-server/layers
TimeoutStartSec=infinity
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
