# shellcheck shell=bash disable=SC2034,SC2154 # makepkg reads the variables and sets pkgdir, startdir
# The tools and the systemd units of the servers (make install, see the Makefile), built from the
# commits of the checkout this file is in: makepkg in deploy/arch. The configs aren't part of it, the
# servers' clone in /var/lib/nwi-server/config has them (README.md).

pkgname=nwi-server-kit-git
pkgver=r0
pkgrel=1
pkgdesc='Tools and systemd units of Day of Infamy and Insurgency servers, and Ghidra tools for the Source SDK'
arch=(any)
url='https://github.com/ChrisTX/doi-config'
license=(MIT)
depends=(
  bash
  git
  metamod-source
  python
  python-a2s
  # The workshop items' VPK signatures
  python-cryptography
  python-srctools
  sourcemod
  # spcomp, which compiles the plugins of the clone at every update
  sourcemod-scripting
  # Downloads the games and the workshop items
  steamdepotdownloader
  util-linux
)
makedepends=(git make python-build python-installer python-hatchling)
optdepends=(
  'python-pyghidra: hl2sdk-ghidra, the Ghidra tools'
  'python-pyelftools: hl2sdk-ghidra vtables'
  'python-capstone: hl2sdk-ghidra signature'
  'python-pefile: hl2sdk-ghidra signature'
  'podman: the container image and the Quadlet units (deploy/quadlet)'
  'sourcemod-advertisements: the advertisements of the configs'
  'sourcemod-multicolors: the colours of the AFK Manager'
  'sourcemod-sourcebans-pp: the bans and admins of the configs'
  'sourcemod-sourcebans-pp-discord-forward: the reports of the configs to Discord'
)
provides=(nwi-server-kit)
conflicts=(nwi-server-kit)
source=("nwi-server-kit::git+file://${startdir%/deploy/arch}")
sha256sums=(SKIP)

pkgver() {
  cd nwi-server-kit || exit
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd nwi-server-kit || exit
  make
}

package() {
  cd nwi-server-kit || exit
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
