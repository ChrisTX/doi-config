# Updates the game, the workshop items and the mods in the state folder ~/.local/state/nwi-server: puts
# an update that nwi-stage.service staged in place, or updates in place, e.g. at boot, the image's
# counterpart of nwi-update.service (tools/update_layers.sh --image)
[Unit]
Description=Update the games, workshop items and mods of the Day of Infamy or Insurgency servers, in a container
Wants=network-online.target
After=network-online.target nwi-build.service
# The servers run on the state folder, which mustn't change while they run
Before=nwi-servers.target

[Container]
Image=localhost/nwi-server
Exec=update
UserNS=keep-id:uid=1000,gid=1000
Volume=%S/nwi-server:/srv/state
# The servers' environment files, which say which games and workshop items to update (tools/games.py)
Volume=%E/nwi-server:/etc/nwi-server:ro
HealthCmd=none

[Service]
Type=oneshot
# Active once done, so a server that starts or restarts on its own doesn't run it again
RemainAfterExit=yes
StateDirectory=nwi-server
TimeoutStartSec=infinity
