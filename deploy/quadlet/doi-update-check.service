# Checks the state folder's game and workshop items for updates, with the image (check_updates.py), and
# restarts the servers on an update, like doi-update-check.service of the systemd units
[Unit]
Description=Check the Day of Infamy game install and workshop items for updates, in a container
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Skips the rest unless there are updates (exit status 1 skips, 255, when it can't tell, fails)
ExecCondition=/usr/bin/podman run --rm --userns=keep-id:uid=1000,gid=1000 --health-cmd=none --volume %S/doi-server:/srv/state localhost/doi-server check
ExecStart=/usr/bin/systemctl --user start --no-block doi-restart.service
