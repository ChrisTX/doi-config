# Stages an update of the state folder in a reflinked copy (next/) while the servers run, which
# doi-update.service puts in place once doi-restart.service has stopped them
[Unit]
Description=Stage an update of the games, workshop items and mods of the Day of Infamy or Insurgency servers, in a container
Wants=network-online.target
After=network-online.target doi-build.service

[Container]
Image=localhost/doi-server
Exec=update --stage
UserNS=keep-id:uid=1000,gid=1000
Volume=%S/doi-server:/srv/state
# The servers' environment files, which say which games and workshop items to update (tools/games.py)
Volume=%E/doi-server:/etc/doi-server:ro
HealthCmd=none

[Service]
Type=oneshot
StateDirectory=doi-server
TimeoutStartSec=infinity
