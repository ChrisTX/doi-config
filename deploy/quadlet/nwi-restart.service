# Rebuilds the image, stages the update while the servers run, stops them, puts the update in place and
# starts them again, like nwi-restart.service of the systemd units: the servers are only down for the
# restart. A failed build or stage leaves the image as it was or the update to nwi-update.service.
[Unit]
Description=Update and restart the Day of Infamy or Insurgency servers, in containers

[Service]
Type=oneshot
ExecStart=-/usr/bin/systemctl --user start nwi-build.service
ExecStart=-/usr/bin/systemctl --user start nwi-stage.service
ExecStart=/usr/bin/systemctl --user stop nwi-servers.target
ExecStart=/usr/bin/systemctl --user restart nwi-update.service
ExecStart=/usr/bin/systemctl --user start nwi-servers.target
