# Rebuilds the image, updates the state folder while the servers run, which adds versions of the layers
# but changes none they use, and restarts them with the newest, like nwi-restart.service of the systemd
# units: the servers are only down for the restart. A failed build leaves the image as it was.
[Unit]
Description=Update and restart the Day of Infamy or Insurgency servers, in containers

[Service]
Type=oneshot
ExecStart=-/usr/bin/systemctl --user start nwi-build.service
ExecStart=/usr/bin/systemctl --user restart nwi-update.service
ExecStart=/usr/bin/systemctl --user restart nwi-servers.target
