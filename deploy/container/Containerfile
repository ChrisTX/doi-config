# The Day of Infamy server, with SourceMod and the plugins from their packages and this configuration,
# without the game and the workshop items: those are the state folder's, which the updater of the same
# image fills with DepotDownloader, as nwi-update.service does for the systemd units (see nwi_server_kit/container.py). The
# image has nothing of the game's, which may not be passed on. See README.md for building and running.
#
# Build arguments:
#   REPO_NAME                      the name of the pacman repository with the packages (aurutils), which
#                                  its database is named after (aurutils.db)
#   REPO_SERVER                    its server, as pacman.conf has it: the public repository
#                                  (https://repo.rev-crew.info/aurutils) by default, file:///mnt/repo for the
#                                  local one of the build context "repo"
#   TESTING                        any value: with Arch Linux's testing repositories, for packages built
#                                  against them
# Build context "repo": a local repository's folder, an empty one for the public repository; secret
# "repo-key": the repository's signing key, the public one's deploy/container/aurutils.asc
# (tests/integration/instance.py build passes them)
# Built in Docker's format (podman build --format docker): OCI images have no HEALTHCHECK

ARG TESTING=

FROM docker.io/library/archlinux:base
ARG TESTING

# A failed download in a pipe fails the step
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The game's libraries (see README.md) and the servers' user with a fixed ID, which the files of the
# volumes belong to: a system user's ID depends on the users the base image has
COPY deploy/container/enable-repos.sh /usr/local/lib/nwi-server-kit/
RUN /usr/local/lib/nwi-server-kit/enable-repos.sh "$TESTING" \
  && pacman -Syu --noconfirm --needed lib32-gcc-libs lib32-glibc lib32-sdl3 lib32-zlib-ng-compat \
  && pacman -Scc --noconfirm \
  && groupadd --gid 1000 nwi-server \
  && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/nwi-server nwi-server \
  && install -d -o nwi-server -g nwi-server /srv/game /srv/state \
    /srv/nwi-data/dumps /srv/nwi-data/logs /srv/nwi-data/sourcemod/logs /srv/nwi-data/sourcemod/data

# The packages from the repository, verified with its key: DepotDownloader (steamdepotdownloader), which
# downloads the games, SourceMod and the plugins, the tools' Python libraries (python-cryptography for
# the workshop items' VPK signatures). SourceMod's optional dependencies, those of
# its MySQL, PostgreSQL, GeoIP, regex and webternet extensions. SourceMod and Metamod:Source go into
# /opt/nwi-layer, the image's files of the game's folder, which the server's entrypoint copies into
# it on every start.
USER 0:0
ARG REPO_NAME=aurutils
ARG REPO_SERVER=https://repo.rev-crew.info/aurutils
RUN --mount=type=bind,from=repo,target=/mnt/repo --mount=type=secret,id=repo-key \
  pacman-key --init \
  && pacman-key --add /run/secrets/repo-key \
  && pacman-key --lsign-key "$(gpg --show-keys --with-colons /run/secrets/repo-key | awk -F: '/^fpr/ { print $10; exit }')" \
  && cp /etc/pacman.conf /etc/pacman.conf.orig \
  && printf '\n[%s]\nSigLevel = Required\nServer = %s\n' "$REPO_NAME" "$REPO_SERVER" >>/etc/pacman.conf \
  && pacman -Syu --noconfirm --needed steamdepotdownloader metamod-source sourcemod sourcemod-scripting \
    python-a2s python-cryptography python-srctools \
    sourcemod-sourcebans-pp sourcemod-sourcebans-pp-discord-forward sourcemod-advertisements \
    sourcemod-multicolors sourcemod-smjansson sourcemod-steamworks \
    lib32-mariadb-connector-c lib32-postgresql-libs lib32-libmaxminddb lib32-pcre2 lib32-curl \
  && mv /etc/pacman.conf.orig /etc/pacman.conf \
  && pacman -Scc --noconfirm \
  && install -d -o nwi-server -g nwi-server /opt/nwi-layer \
  && cp -a --no-preserve=ownership /usr/lib/metamod/. /usr/lib/sourcemod/. /opt/nwi-layer/ \
  && chown -R nwi-server:nwi-server /opt/nwi-layer

# This repository and its plugins, on top of SourceMod in /opt/nwi-layer
USER 1000:1000
COPY --chown=nwi-server:nwi-server . /opt/nwi-server-kit
# The package of the tools, from the repository (python -m nwi_server_kit)
ENV PYTHONPATH=/opt/nwi-server-kit/src
RUN python3 -m nwi_server_kit compile-plugins /opt/nwi-server-kit /tmp/plugins \
  && cp -a /tmp/plugins/. /opt/nwi-server-kit/game/. /opt/nwi-layer/ \
  && rm -rf /tmp/plugins

WORKDIR /srv/game
ENV LD_LIBRARY_PATH=/srv/game:/srv/game/bin
# SRCDS shuts down on SIGINT, which the watchdog (nwi-server start) passes on
STOPSIGNAL SIGINT
# The server answers A2S queries, as the systemd units' watchdog checks; the port is SERVER_PORT
HEALTHCHECK --start-period=10m --interval=30s --retries=3 \
  CMD ["python3", "-m", "nwi_server_kit", "watchdog", "--check"]
# The image's commands: the server by default, update and check (nwi_server_kit.container)
ENTRYPOINT ["python3", "-m", "nwi_server_kit", "container"]
