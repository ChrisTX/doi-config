# The Day of Infamy server, with SourceMod and the plugins from their packages and this configuration,
# without the game and the workshop items: those are the state folder's, which the updater of the same
# image fills with SteamCMD, as doi-update.service does for the systemd units (see entrypoint.sh). The
# image has nothing of the game's, which may not be passed on. See README.md for building and running.
#
# Build arguments:
#   REPO_NAME                      the name of the pacman repository with the packages (aur), which its
#                                  database is named after (aur.db)
#   TESTING                        any value: with Arch Linux's testing repositories, for packages built
#                                  against them
# Build context "repo": the pacman repository's folder, secret "repo-key": its signing key
# Built in Docker's format (podman build --format docker): OCI images have no HEALTHCHECK

ARG TESTING=

FROM docker.io/library/archlinux:base
ARG TESTING

# A failed download in a pipe fails the step
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The game's libraries (see README.md) and the servers' user with a fixed ID, which the files of the
# volumes belong to: a system user's ID depends on the users the base image has
COPY deploy/container/enable-repos.sh /usr/local/lib/doi/
RUN /usr/local/lib/doi/enable-repos.sh "$TESTING" \
  && pacman -Syu --noconfirm --needed lib32-gcc-libs lib32-glibc lib32-sdl3 lib32-zlib-ng-compat \
  && pacman -Scc --noconfirm \
  && groupadd --gid 1000 doi \
  && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/doi doi \
  && install -d -o doi -g doi /srv/doi /srv/state /opt/steamcmd \
    /srv/doi-data/dumps /srv/doi-data/logs /srv/doi-data/sourcemod/logs /srv/doi-data/sourcemod/data

# SteamCMD, which updates itself on its first run (and may exit with an error status after that)
USER 1000:1000
RUN curl -fsSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz | tar -xz -C /opt/steamcmd \
  && { /opt/steamcmd/steamcmd.sh +quit || test -x /opt/steamcmd/linux32/steamcmd; }
USER 0:0
RUN printf '#!/bin/sh\nexec /opt/steamcmd/steamcmd.sh "$@"\n' >/usr/local/bin/steamcmd \
  && chmod 755 /usr/local/bin/steamcmd

# The packages from the repository, verified with its key. SourceMod's optional dependencies, those of
# its MySQL, PostgreSQL, GeoIP, regex and webternet extensions. SourceMod and Metamod:Source go into
# /opt/doi-layer, the image's files of the game's doi folder, which the server's entrypoint copies into
# it on every start.
USER 0:0
ARG REPO_NAME=aur
RUN --mount=type=bind,from=repo,target=/mnt/repo --mount=type=secret,id=repo-key \
  pacman-key --init \
  && pacman-key --add /run/secrets/repo-key \
  && pacman-key --lsign-key "$(gpg --show-keys --with-colons /run/secrets/repo-key | awk -F: '/^fpr/ { print $10; exit }')" \
  && cp /etc/pacman.conf /etc/pacman.conf.orig \
  && printf '\n[%s]\nServer = file:///mnt/repo\n' "$REPO_NAME" >>/etc/pacman.conf \
  && pacman -Syu --noconfirm --needed metamod-source sourcemod sourcemod-scripting python-a2s \
    sourcemod-sourcebans-pp sourcemod-sourcebans-pp-discord-forward sourcemod-advertisements \
    sourcemod-multicolors sourcemod-smjansson sourcemod-steamworks \
    lib32-mariadb-connector-c lib32-postgresql-libs lib32-libmaxminddb lib32-pcre2 lib32-curl \
  && mv /etc/pacman.conf.orig /etc/pacman.conf \
  && pacman -Scc --noconfirm \
  && install -d -o doi -g doi /opt/doi-layer \
  && cp -a --no-preserve=ownership /usr/lib/metamod/. /usr/lib/sourcemod/. /opt/doi-layer/ \
  && chown -R doi:doi /opt/doi-layer

# This repository and its plugins, on top of SourceMod in /opt/doi-layer
USER 1000:1000
COPY --chown=doi:doi . /opt/doi-config
RUN /opt/doi-config/tools/update_game.sh --plugins /tmp/plugins \
  && cp -a /tmp/plugins/. /opt/doi-config/game/. /opt/doi-layer/ \
  && rm -rf /tmp/plugins

WORKDIR /srv/doi
ENV LD_LIBRARY_PATH=/srv/doi:/srv/doi/bin
# SRCDS shuts down on SIGINT, which srcds_watchdog.py passes on
STOPSIGNAL SIGINT
# The server answers A2S queries, as the systemd units' watchdog checks; the port is SERVER_PORT
HEALTHCHECK --start-period=10m --interval=30s --retries=3 \
  CMD ["python3", "/opt/doi-config/tools/srcds_watchdog.py", "--check"]
ENTRYPOINT ["/opt/doi-config/deploy/container/entrypoint.sh"]
